<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp" android:layoutDirection="rtl">
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="تنظیمات هشدار" android:textSize="24sp" android:textStyle="bold" android:textColor="@color/text" android:gravity="center"/>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:background="@drawable/card_white" android:orientation="vertical">
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="🎵  صدای اعلان" android:textSize="19sp" android:textStyle="bold" android:textColor="@color/text"/>
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="صدای اختصاصی برای پیامک‌های مهم" android:textColor="@color/muted"/>
   <TextView android:id="@+id/soundText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:background="@drawable/input_bg" android:padding="16dp" android:textColor="@color/text"/>
   <Button android:id="@+id/soundButton" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="10dp" android:text="انتخاب صدا"/>
   <Button android:id="@+id/defaultSoundButton" android:layout_width="match_parent" android:layout_height="52dp" android:text="صدای پیش‌فرض"/>
  </LinearLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:background="@drawable/card_white" android:orientation="vertical">
   <Switch android:id="@+id/vibration" android:layout_width="match_parent" android:layout_height="60dp" android:text="📳  ویبره
همراه با صدا دستگاه ویبره کند"/>
  </LinearLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:background="@drawable/card_white" android:orientation="vertical">
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="⏰  تکرار هشدار" android:textSize="19sp" android:textStyle="bold" android:textColor="@color/text"/>
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="تعداد تکرار" android:textColor="@color/muted" android:layout_marginTop="12dp"/>
   <Spinner android:id="@+id/repeatCount" android:layout_width="match_parent" android:layout_height="52dp"/>
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="فاصله بین تکرارها (دقیقه)" android:textColor="@color/muted"/>
   <EditText android:id="@+id/interval" android:layout_width="match_parent" android:layout_height="52dp" android:inputType="number"/>
  </LinearLayout>
  <Button android:id="@+id/saveButton" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="18dp" android:text="ذخیره تنظیمات"/>
  <Button android:id="@+id/channelButton" android:layout_width="match_parent" android:layout_height="52dp" android:text="تنظیمات اعلان در اندروید"/>
  <TextView android:id="@+id/channelStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:layout_marginBottom="24dp" android:background="@drawable/card_blue" android:padding="14dp" android:textColor="@color/muted"/>
 </LinearLayout>
</ScrollView>
