<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
   <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="SMS Alert" android:textColor="@color/text" android:textSize="25sp" android:textStyle="bold"/>
   <ImageButton android:id="@+id/settingsButton" android:layout_width="48dp" android:layout_height="48dp" android:background="@android:color/transparent" android:src="@android:drawable/ic_menu_preferences" android:contentDescription="تنظیمات"/>
  </LinearLayout>
  <ImageView android:layout_width="150dp" android:layout_height="150dp" android:layout_gravity="center" android:layout_marginTop="20dp" android:src="@drawable/ic_sms_alert"/>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="هشدار پیامک‌های مهم" android:textColor="@color/text" android:textSize="24sp" android:textStyle="bold"/>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:text="دریافت اعلان و صدای اختصاصی برای پیامک‌های مهم از مخاطبین شما یا حاوی کلمات کلیدی" android:textColor="@color/muted" android:textSize="15sp"/>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:background="@drawable/card_blue" android:orientation="vertical">
   <Switch android:id="@+id/contacts" android:layout_width="match_parent" android:layout_height="64dp" android:text="مخاطبین ذخیره‌شده
هشدار برای پیامک شماره‌های موجود در مخاطبین" android:textColor="@color/text"/>
   <Switch android:id="@+id/keywordsSwitch" android:layout_width="match_parent" android:layout_height="64dp" android:text="کلمات کلیدی
هشدار برای پیامک‌های حاوی کلمات مشخص" android:textColor="@color/text"/>
   <Button
    android:id="@+id/manageKeywordsButton"
    android:layout_width="match_parent"
    android:layout_height="52dp"
    android:layout_marginTop="6dp"
    android:text="مدیریت کلمات کلیدی  ←"/>

  </LinearLayout>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="وضعیت دسترسی‌ها" android:textColor="@color/text" android:textSize="18sp" android:textStyle="bold" android:gravity="right"/>
  <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/card_white" android:padding="18dp" android:textColor="@color/text" android:textSize="15sp" android:lineSpacingExtra="10dp"/>
  <Button android:id="@+id/permissionButton" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="12dp" android:text="اعطای دسترسی‌های لازم"/>
  <Button android:id="@+id/testButton" android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginTop="12dp" android:layout_marginBottom="24dp" android:text="▶  تست صدا و ویبره"/>
 </LinearLayout>
</ScrollView>
